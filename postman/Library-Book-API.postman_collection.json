{
  "info": {
    "name": "Library Book Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "(c) GET all books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "(c) GET book by ID (exists)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/101",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "101"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "(c) GET book by ID (not found)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "999"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "(b) POST add new book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": 201,\n  \"title\": \"Effective Java\",\n  \"author\": \"Joshua Bloch\",\n  \"genre\": \"Programming\",\n  \"availableCopies\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "(b) POST duplicate bookId (rejected)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": 101,\n  \"title\": \"Duplicate\",\n  \"author\": \"X\",\n  \"genre\": \"Y\",\n  \"availableCopies\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 409', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "(b) POST negative availableCopies (rejected)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": 202,\n  \"title\": \"Bad Copies\",\n  \"author\": \"X\",\n  \"genre\": \"Y\",\n  \"availableCopies\": -1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "(d) PUT issue book (success)",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/102/issue",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "102",
            "issue"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "(d) PUT issue book (not found)",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/999/issue",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "999",
            "issue"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "(d) PUT issue book (no copies left) - run twice on 103",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/103/issue",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "103",
            "issue"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 first time, 400 once copies are exhausted', function () { pm.expect([200, 400]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Extra: PUT return book",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/102/return",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "102",
            "return"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Extra: DELETE book",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/201",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "201"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 or 404', function () { pm.expect([200, 404]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    }
  ]
}